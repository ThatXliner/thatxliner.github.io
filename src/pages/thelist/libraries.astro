---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import ListTabs from "@/components/ListTabs.astro";
import { apps } from "@/data/apps";
import { libraries } from "@/data/libraries";
import { getRepoStars } from "@/lib/github";

// Fetched at build time so the counts can't drift the way stored ones did.
const stars = await getRepoStars(
    libraries.map((lib) => lib.repoName ?? lib.name),
);
---

<Layout
    title="The List — Libraries by Bryan Hu"
    description="Developer-facing work by Bryan Hu: Python libraries, Rust tooling, project templates, and editor plugins. All published, all open source."
    image="/og/thelist.png"
>
    <Nav />

    <main>
        <!-- ── Header ──────────────────────────────────────────────────── -->
        <section class="mx-auto max-w-[1180px] px-gutter pt-32 pb-4 md:pt-40">
            <p class="t-eyebrow rise">The List</p>
            <h1 class="t-display mt-3 max-w-[20ch] text-balance">
                <span class="mask mask-load"><span>Everything</span></span>
                <span class="mask mask-load text-fg-muted"
                    ><span style="animation-delay:110ms">I've made.</span></span
                >
            </h1>
            <p
                class="t-lede rise mt-7 max-w-[56ch] text-balance"
                style="animation-delay:220ms"
            >
                The developer half: things you install, import, or scaffold a
                project from. Mostly Python and Rust, mostly built because the
                existing option annoyed me.
            </p>

            <div class="rise mt-9" style="animation-delay:300ms">
                <ListTabs
                    active="libraries"
                    appCount={apps.length}
                    libraryCount={libraries.length}
                />
            </div>
        </section>

        <!-- ── Index ───────────────────────────────────────────────────── -->
        <section class="mx-auto max-w-[1180px] px-gutter pt-12 pb-20 md:pt-16">
            <ul>
                {
                    libraries.map((lib) => {
                        const count = stars[lib.repoName ?? lib.name];
                        return (
                            <li class="reveal border-t border-hairline">
                                <div class="grid gap-x-10 gap-y-3 py-7 md:grid-cols-[minmax(0,1fr)_auto] md:py-8">
                                    <div>
                                        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                                            <h2 class="t-headline text-[1.125rem] md:text-[1.25rem]">
                                                <a
                                                    href={lib.repo}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="transition-colors hover:text-accent"
                                                >
                                                    {lib.name}
                                                </a>
                                            </h2>
                                            <span class="t-caption">
                                                {lib.ecosystem}
                                            </span>
                                            {count !== undefined && count > 0 && (
                                                <span class="t-caption tnum flex items-center gap-1">
                                                    <Icon
                                                        name="octicon:star-24"
                                                        class="size-3"
                                                    />
                                                    {count.toLocaleString(
                                                        "en-US",
                                                    )}
                                                </span>
                                            )}
                                        </div>

                                        <p class="t-body mt-2 max-w-[62ch] text-[0.9375rem]">
                                            {lib.tagline}
                                        </p>

                                        <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2">
                                            <a
                                                href={lib.repo}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="flex items-center gap-1.5 text-[0.875rem] text-fg-muted transition-colors hover:text-fg"
                                            >
                                                <Icon
                                                    name="simple-icons:github"
                                                    class="size-3.5"
                                                />
                                                Source
                                            </a>
                                            {lib.registry && (
                                                <a
                                                    href={lib.registry.url}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="a-link text-[0.875rem]"
                                                >
                                                    {lib.registry.label}
                                                    <span
                                                        class="chev"
                                                        aria-hidden="true"
                                                    >
                                                        &rsaquo;
                                                    </span>
                                                </a>
                                            )}
                                        </div>
                                    </div>

                                    {lib.install && (
                                        <div class="md:self-center">
                                            <code class="inline-block rounded-md border border-hairline bg-surface px-3.5 py-2 font-mono text-[0.8125rem] text-fg-muted select-all">
                                                {lib.install}
                                            </code>
                                        </div>
                                    )}
                                </div>
                            </li>
                        );
                    })
                }
            </ul>
        </section>

        <section
            class="mx-auto max-w-[1180px] px-gutter pb-24 text-center md:pb-36"
        >
            <div
                class="reveal flex flex-wrap items-center justify-center gap-x-7 gap-y-4"
            >
                <a href="/thelist" class="btn btn-primary">See the apps</a>
                <a
                    href="https://github.com/ThatXliner?tab=repositories"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-1.5 text-[0.9375rem] text-fg-muted transition-colors hover:text-fg"
                >
                    <Icon name="simple-icons:github" class="size-4" />
                    Browse all of them
                </a>
            </div>
        </section>
    </main>

    <Footer />
</Layout>
