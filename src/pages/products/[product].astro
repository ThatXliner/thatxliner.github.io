---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import PhoneFrame from "../../components/ui/PhoneFrame.astro";
import WindowFrame from "../../components/ui/WindowFrame.astro";
import billionBrowse from "../../assets/products/billion-browse.png";
import billionFeed from "../../assets/products/billion-feed.png";
import quillium from "../../assets/products/quillium-revision.png";
export function getStaticPaths() {
    return ["billion", "quillium"].map((product) => ({ params: { product } }));
}
const isBillion = Astro.params.product === "billion";
const name = isBillion ? "Billion" : "Quillium";
const points = isBillion
    ? [
          ["Dual-Lens view", "Progressive and conservative readings of the same bill, side by side."],
          ["Your ballot", "Track what you’re voting on, and who is on the ballot."],
          ["Primary sources", "Every summary cites the original documents."],
      ]
    : [
          ["Branching drafts", "Keep alternative versions inside the document until you choose one."],
          ["Local-first writing", "One SQLite file on your disk, with crash-safe storage and offline access."],
          ["Anchored notes", "Attach comments to the exact words they refer to."],
      ];
const description = isBillion
    ? "Most people find out what their government did after it has already changed their life. I’m building Billion to make bills, executive orders, and court rulings easier to follow."
    : "I built Quillium because I kept losing the better draft. Write a sentence three ways and decide later. Every version stays inside the document.";
---

<Layout title={`${name} — Bryan Hu`} description={description}>
    <Nav />
    <main class="product-story">
        <div class="product-top">
            <a class="a-link back" href="/#build"><span class="chev" aria-hidden="true">←</span> Back to my work</a>
            <nav aria-label="Products">
                <a href="/products/billion" aria-current={isBillion ? "page" : undefined}>Billion</a>
                <a href="/products/quillium" aria-current={!isBillion ? "page" : undefined}>Quillium</a>
            </nav>
        </div>
        <section class:list={["product-detail", { "product-detail-wide": !isBillion }]}>
            <div>
                <p class="hand rise">{name}</p>
                <h1 class="t-title">
                    {
                        isBillion ? (
                            <>
                                <span class="mask mask-load"><span>Know what</span></span>
                                <span class="mask mask-load"><span style="animation-delay:70ms">your government</span></span>
                                <span class="mask mask-load text-fg-muted"><span style="animation-delay:140ms">is doing.</span></span>
                            </>
                        ) : (
                            <>
                                <span class="mask mask-load"><span>Keep the</span></span>
                                <span class="mask mask-load text-fg-muted"><span style="animation-delay:70ms">better draft.</span></span>
                            </>
                        )
                    }
                </h1>
                <p class="t-lede rise description" style="animation-delay:220ms">{description}</p>
                {isBillion && <p class="t-body rise origin" style="animation-delay:280ms">It started as my Congressional App Challenge entry, which placed 3rd in CA-19 in 2025, and grew into the product I’m building today.</p>}
                <a class="btn btn-primary rise explore" style="animation-delay:340ms" href={isBillion ? "https://www.billion-news.app/" : "https://quillium.bryanhu.com/"}>{isBillion ? "Explore Billion" : "Explore Quillium"} <span aria-hidden="true">↗</span></a>
            </div>
            <div class="rise" style="animation-delay:200ms">
                <div class="product-art" data-tilt>
                    {
                        isBillion ? (
                            <>
                                <PhoneFrame src={billionBrowse} alt="Billion Browse: recent bills with plain-language titles" class="drift-slow" />
                                <PhoneFrame src={billionFeed} alt="Billion bill summary with political perspectives and a source link" class="drift-fast phone-low" />
                            </>
                        ) : (
                            <WindowFrame src={quillium} alt="Quillium editor with alternative drafts and comments" title="A Tale of Two Cities — draft" class="drift-slow" />
                        )
                    }
                </div>
            </div>
        </section>
    </main>
    <section class="paper sheet product-sheet" aria-label={`${name} features`}>
        <div class="product-features">
            {
                points.map(([title, body]) => (
                    <article data-reveal>
                        <h2 class="t-headline">{title}</h2>
                        <p class="t-body">{body}</p>
                    </article>
                ))
            }
        </div>
    </section>
    <Footer />
</Layout>

<script>
    import { lifetime } from "../../lib/motion";
    import { initTilt } from "../../lib/interaction";
    const signal = lifetime();
    document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((element) => initTilt(element, signal));
</script>

<style>
    .product-story {
        max-width: 1320px;
        margin-inline: auto;
        padding: 6.5rem var(--spacing-gutter) clamp(4rem, 8vw, 7rem);
    }
    .product-top {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem 1.5rem;
        font-size: 0.9375rem;
    }
    .back {
        min-height: 2.75rem;
    }
    .back:hover .chev {
        transform: translateX(-3px);
    }
    .product-top nav {
        display: flex;
        gap: 1.25rem;
    }
    .product-top nav a {
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
        color: var(--color-fg-muted);
    }
    .product-top nav a:hover {
        color: var(--color-fg);
    }
    .product-top nav a[aria-current] {
        color: var(--color-fg);
        text-decoration: underline;
        text-decoration-color: var(--color-accent);
        text-underline-offset: 6px;
    }
    .product-detail {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: clamp(2.5rem, 6vw, 6rem);
        align-items: center;
        padding-top: clamp(2.5rem, 6vw, 5rem);
    }
    .product-detail-wide {
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
    .hand {
        margin-bottom: 1rem;
    }
    .description {
        max-width: 38ch;
        margin-top: 1.75rem;
    }
    .origin {
        max-width: 44ch;
        margin-top: 1rem;
    }
    .explore {
        margin-top: 1.75rem;
    }
    .product-art {
        display: flex;
        align-items: flex-start;
        justify-content: center;
        gap: clamp(1rem, 2.4vw, 1.75rem);
    }
    .product-art :global(.phone-low) {
        margin-top: clamp(2.5rem, 5vw, 4rem);
    }
    .product-sheet {
        border-end-start-radius: 0;
        border-end-end-radius: 0;
    }
    .product-features {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 2rem clamp(2rem, 5vw, 4rem);
        max-width: 1320px;
        margin-inline: auto;
        padding: clamp(3.5rem, 7vw, 6rem) var(--spacing-gutter);
    }
    .product-features .t-body {
        margin-top: 0.625rem;
    }
    @media (max-width: 860px) {
        .product-detail,
        .product-detail-wide {
            grid-template-columns: minmax(0, 1fr);
        }
        .product-features {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
