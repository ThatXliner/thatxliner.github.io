---
import { getImage } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import PlayablePiano from "@/components/PlayablePiano.astro";
import { FEATURES } from "@/flags";
import { resume } from "@/data/resume";
import { prints } from "@/data/print-selection";
import { photographs } from "@/data/photography";
import RoomOS from "@/components/RoomOS.astro";
import RoomPlaces from "@/components/RoomPlaces.astro";
import { stops } from "@/data/story";
import { getReleases } from "@/data/music";
import billionSite from "@/assets/room/billion-site.png";
import quilliumSite from "@/assets/room/quillium-site.png";
import quilliumSiteLight from "@/assets/room/quillium-site-light.png";
import { projects } from "@/data/projects";
import { apps } from "@/data/apps";
import { skills } from "@/data/skills";
import { getAllRepositories } from "@/lib/github";

// A single dynamic route, so `return []` keeps the experiment out of the build.
export function getStaticPaths() {
    return FEATURES.room ? [{ params: { path: undefined } }] : [];
}

const web = async (src: ImageMetadata, width: number) => (await getImage({ src, width, format: "webp" })).src;
// Every photograph Bryan has picked as featured hangs on the back wall.
const framed = prints;
const releases = await getReleases();
const room = {
    // The path, stitched into the rug; the releases, on the music room's records.
    story: stops.map(({ year, title, icon }) => ({ year, title, icon })),
    releases: releases.map(({ title, artwork }) => ({ title, artwork })),
    wallpaper: await web(prints[1].image, 2048),
    // How the two product sites looked when captured; the live ones load in iframes at the desk.
    billion: await web(billionSite, 1520),
    quillium: await web(quilliumSite, 2200),
    // Quillium follows the visitor's light/dark setting, inside the iframe too.
    quilliumLight: await web(quilliumSiteLight, 2200),
    // The gallery through the door: every photograph, in /photography's order.
    photographs: await Promise.all(
        photographs.map(async (photo) => ({
            thumb: await web(photo.image, 1024),
            large: await web(photo.image, Math.min(2000, photo.image.width)),
            aspect: photo.image.width / photo.image.height,
            title: photo.title,
            alt: photo.alt,
            date: photo.date,
            camera: photo.camera,
        })),
    ),
    labels: {
        projects: ["Billion", "Quillium", ...projects.map((p) => p.name), ...apps.map((a) => a.name)].slice(0, 14),
        repos: (await getAllRepositories())
            .filter((repo) => repo.isPublic)
            .sort((a, b) => b.starCount - a.starCount)
            .slice(0, 10)
            .map((repo) => repo.name),
        skills: skills.map((skill) => ({ name: skill.name, color: skill.color })),
    },
    prints: await Promise.all(framed.map(async (print) => ({ src: await web(print.image, 768), aspect: print.image.width / print.image.height }))),
};
---

<Layout title="Bryan Hu — The Room" description="A walk through the room where I build apps, take photographs and play music.">
    <main class="room" data-room={JSON.stringify(room)} data-state="loading">
        <p class="room-status t-caption" data-room-status role="status"></p>
        <div class="room-track" data-room-track>
            <div class="room-stage">
                <canvas class="room-canvas" data-room-canvas aria-hidden="true"></canvas>
                <div class="room-shade" aria-hidden="true"></div>
            </div>

            <div class="room-chapters">
                <section class="chapter chapter-hero" data-chapter="hero">
                    <h1 class="t-title">
                        <span class="text-fg-muted">Hi, I’m</span> Bryan.
                    </h1>
                    <p class="t-lede">I build apps and open-source tools. <span class="text-fg-muted">I also make photographs and music.</span></p>
                    <p class="cue"><span class="hand">come in. scroll.</span> <button type="button" class="skip" data-skip>or skip to the end <span aria-hidden="true">↓</span></button></p>
                </section>

                <section class="chapter chapter-right" data-chapter="photography">
                    <p class="hand">I also point cameras at things.</p>
                    <h2 class="t-title">Look <span class="text-fg-muted">closer.</span></h2>
                    <p class="t-lede">I photograph, operate cameras, and switch live productions. Then comes the editing, color grading, and sound.</p>
                    <div class="links">
                        <a class="btn btn-ghost" data-glass href="/photography">See the photographs <span aria-hidden="true">→</span></a>
                    </div>
                </section>

                <section class="chapter chapter-left" data-chapter="trombone">
                    <p class="hand">there’s usually music involved.</p>
                    <h2 class="t-title">Trombone, <span class="text-fg-muted">jazz and classical.</span></h2>
                </section>

                <section class="chapter chapter-left" data-chapter="piano">
                    <h2 class="t-title">Keys, <span class="text-fg-muted">too.</span></h2>
                    <p class="t-lede">I’m a pianist and trombonist. I perform solo, play in concert and jazz bands, and release music.</p>
                    <div class="links">
                        <a class="btn btn-ghost" data-glass href="https://open.spotify.com/artist/3CfXIgxCs9Sv7eVgZzqSEj">Spotify <span aria-hidden="true">↗</span></a>
                        <a class="btn btn-ghost" data-glass href="https://music.apple.com/us/artist/bryan-hu/1751789628">Apple Music <span aria-hidden="true">↗</span></a>
                    </div>
                </section>

                <section class="chapter chapter-end" data-chapter="end">
                    <p class="hand explore-hint">the tour’s over. drag to look around, click any dot to walk over.</p>
                    <h2 class="t-title">I build things, <span class="text-fg-muted">then I rebuild them.</span></h2>
                    <div class="links">
                        <a class="btn btn-primary" href={`mailto:${resume.email}`}>{resume.email}</a>
                        <a class="btn btn-ghost" data-glass href="/resume.pdf">Résumé <span aria-hidden="true">↗</span></a>
                        <a class="a-underline" href="/">The regular site <span aria-hidden="true">→</span></a>
                    </div>
                </section>
            </div>
        </div>

        <button type="button" class="sound" data-sound aria-pressed="true" aria-label="Turn sound off">
            <span aria-hidden="true"><i></i><i></i><i></i></span>
        </button>

        <RoomOS />
        <RoomPlaces releases={releases} />

        <!-- The gallery through the door. The camera does the walking; these are the words. -->
        <div class="hall" data-hall hidden>
            <header class="hall-head">
                <button type="button" class="hall-back" data-hall-back><span aria-hidden="true">←</span> Back to the room</button>
                <div class="hall-title">
                    <h2>Photographs</h2>
                    <p>{photographs.length} photographs. Scroll to walk the wall, click one to look closer.</p>
                </div>
                <a class="hall-full" href="/photography">The full page <span aria-hidden="true">↗</span></a>
            </header>
            <p class="hall-caption" data-hall-caption aria-live="polite"></p>
        </div>
        <div class="lightbox" data-lightbox hidden role="dialog" aria-modal="true" aria-labelledby="lightbox-title">
            <figure>
                <img data-lightbox-img alt="" />
                <figcaption>
                    <h3 id="lightbox-title" data-lightbox-title></h3>
                    <p class="lightbox-meta tnum" data-lightbox-meta></p>
                    <p class="lightbox-alt" data-lightbox-alt></p>
                </figcaption>
            </figure>
            <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close">×</button>
            <button type="button" class="lightbox-step lightbox-prev" data-lightbox-prev aria-label="Previous photograph">←</button>
            <button type="button" class="lightbox-step lightbox-next" data-lightbox-next aria-label="Next photograph">→</button>
        </div>

        <!-- Only shown once the script takes over; without it, the page is the static version. -->
        <div class="room-loader" data-room-loader>
            <div class="loader-line">
                <p class="loader-readout t-caption" role="status" aria-live="polite">
                    <span data-loader-label>Moving the furniture in</span>
                    <span class="tnum" data-loader-readout>0%</span>
                </p>
                <div class="loader-track" aria-hidden="true"><i data-loader-bar></i></div>
                <button class="btn btn-primary loader-enter" type="button" data-loader-enter hidden>Come in <span aria-hidden="true">↓</span></button>
            </div>
            <PlayablePiano />
        </div>
    </main>
</Layout>

<style>
    .room-track {
        position: relative;
    }
    .room-stage {
        display: none;
    }
    .room-chapters {
        display: grid;
        gap: 6rem;
        padding: 8rem var(--page-edge);
    }
    .room {
        --piano-h: clamp(5.75rem, 17svh, 10.5rem);
    }
    .room-status {
        display: none;
        margin: 0;
        padding: 6rem var(--page-edge) 0;
        color: var(--color-fg-muted);
    }
    .room[data-state="fallback"] .room-status {
        display: block;
    }

    /* The wait: a progress line over a piano along the bottom of the screen. */
    .room-loader {
        display: none;
    }
    .room[data-loader] .room-loader {
        position: fixed;
        inset: auto 0 0;
        z-index: 5;
        display: grid;
        gap: 3.75rem;
        transition:
            translate 700ms var(--spring),
            opacity 450ms ease;
    }
    .room-loader[data-leaving] {
        translate: 0 calc(100% + 2rem);
        opacity: 0;
    }
    .loader-line {
        justify-self: end;
        width: min(17rem, 60vw);
        margin-right: var(--page-edge);
        display: grid;
        gap: 0.6rem;
    }
    .loader-readout {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin: 0;
        color: var(--color-fg-muted);
    }
    .loader-track {
        height: 1px;
        background: var(--color-hairline);
        overflow: hidden;
    }
    .loader-track i {
        display: block;
        height: 100%;
        background: var(--color-fg);
        transform-origin: 0 50%;
        transform: scaleX(0);
        transition: transform 300ms ease-out;
    }
    .loader-enter {
        justify-self: end;
        margin-top: 0.4rem;
    }
    .room[data-loader]:not([data-loader="off"]) .cue {
        opacity: 0;
        visibility: hidden;
    }
    /* The intro waits above the keys, then settles to its place as they drop away. */
    .chapter-hero {
        transition: bottom 700ms var(--spring);
    }
    .room[data-state][data-loader="on"] .chapter-hero {
        bottom: calc(var(--piano-h) + 9.5rem);
    }

    /* Live: the track becomes the film's length and everything else floats over the stage. */
    .room:is([data-state="loading"], [data-state="live"]) .room-track {
        height: 1100vh;
    }
    .room:is([data-state="loading"], [data-state="live"]) .room-stage {
        display: block;
        position: sticky;
        top: 0;
        height: 100svh;
        overflow: hidden;
        background: #050506;
    }
    .room-canvas {
        display: block;
        /* Vertical swipes still scroll; horizontal ones turn your head at the end. */
        touch-action: pan-y;
        width: 100%;
        height: 100%;
        opacity: 0;
        transition: opacity 1200ms var(--spring);
    }
    .room[data-state="live"] .room-canvas {
        opacity: 1;
    }
    .room[data-exploring] .room-canvas {
        cursor: grab;
    }
    .room[data-looking] .room-canvas {
        cursor: grabbing;
    }
    /* The sound switch: three bars that lie down when it's off. */
    .sound {
        display: none;
    }
    .room[data-state="live"][data-loader="off"] .sound {
        position: fixed;
        right: var(--page-edge);
        bottom: 1.25rem;
        z-index: 4;
        display: grid;
        place-items: center;
        width: 2.25rem;
        height: 2.25rem;
        padding: 0;
        border: 1px solid rgb(255 255 255 / 0.16);
        border-radius: 50%;
        background: rgb(12 12 14 / 0.42);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        color: var(--color-fg);
        cursor: pointer;
        transition:
            background-color 0.2s,
            scale 0.3s var(--spring);
    }
    .sound:hover {
        background: rgb(12 12 14 / 0.62);
    }
    .sound:active {
        scale: 0.94;
    }
    .sound span {
        display: flex;
        align-items: center;
        gap: 2.5px;
        height: 0.8rem;
    }
    .sound i {
        width: 2px;
        height: 100%;
        border-radius: 1px;
        background: currentColor;
        transition:
            scale 0.35s var(--spring),
            opacity 0.2s;
    }
    .sound i:nth-child(1) {
        scale: 1 0.45;
    }
    .sound i:nth-child(3) {
        scale: 1 0.7;
    }
    .sound[aria-pressed="false"] i {
        scale: 1 0.16;
        opacity: 0.55;
    }
    @media (prefers-reduced-motion: reduce) {
        .sound,
        .sound i {
            transition: none;
        }
    }
    .room-shade {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: radial-gradient(120% 95% at 50% 45%, transparent 58%, rgb(0 0 0 / 0.42));
    }
    .room:is([data-state="loading"], [data-state="live"]) .room-chapters {
        position: fixed;
        inset: 0;
        display: block;
        padding: 0;
        pointer-events: none;
    }
    .room:is([data-state="loading"], [data-state="live"]) .chapter {
        position: absolute;
        opacity: 0;
        will-change: opacity, transform;
    }
    .room[data-state="loading"] .chapter-hero {
        opacity: 1;
    }

    .chapter {
        max-width: 34rem;
        display: grid;
        gap: 1.1rem;
        text-shadow: 0 1px 24px rgb(0 0 0 / 0.5);
    }
    /* Once the room is drawing, it draws these itself: the scrims behind the
       words, and the glass under outline buttons (lib/room/glass.ts). */
    .room[data-state="live"] [data-glass] {
        border-color: transparent;
        background: none;
    }
    .room[data-state="live"] [data-glass]:active {
        transform: none;
    }
    /* Type over footage needs a floor to stand on, wherever on screen it lands.
       Only while loading; once live, the room's own shader draws it. */
    .room[data-state="loading"] .chapter::before {
        content: "";
        position: absolute;
        inset: -45% -35%;
        z-index: -1;
        background: radial-gradient(closest-side, rgb(5 5 6 / 0.7), rgb(5 5 6 / 0.35) 60%, transparent);
        pointer-events: none;
    }
    .chapter-left {
        left: var(--page-edge);
        top: 50%;
        translate: 0 -50%;
    }
    .chapter-right {
        right: var(--page-edge);
        top: 50%;
        translate: 0 -50%;
    }
    .chapter-hero {
        left: var(--page-edge);
        bottom: 14vh;
    }
    /* The end of the tour is the start of exploring: the words step to a
       corner so the room, and its dots, have the middle. */
    .chapter-end {
        left: var(--page-edge);
        bottom: 7vh;
        max-width: 34rem;
    }
    .chapter-end .t-title {
        font-size: clamp(2rem, 4.2vw, 3.6rem);
    }
    .explore-hint {
        margin: 0;
        color: #7fa8ff;
        font-size: 1.15rem;
    }
    .skip {
        margin-left: 0.6rem;
        padding: 0;
        border: 0;
        background: none;
        color: var(--color-fg-muted);
        font: inherit;
        font-size: 0.875rem;
        text-decoration: underline;
        text-underline-offset: 0.2em;
        text-decoration-color: var(--color-hairline-strong);
        cursor: pointer;
        pointer-events: auto;
    }
    .skip:hover {
        color: var(--color-fg);
    }
    .chapter .t-title {
        margin: 0;
    }
    .chapter .t-lede {
        margin: 0;
    }
    .name {
        font-weight: 600;
        color: var(--color-fg-muted);
        margin: 0;
    }
    .cue {
        margin-top: 1rem;
        color: var(--color-fg-muted);
    }
    .cue .hand {
        color: var(--color-fg-muted);
    }
    .links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem 1.25rem;
        margin-top: 0.5rem;
    }

    /* The hall is pale, so its words are dark: ink on a gallery wall. */
    .hall {
        position: fixed;
        inset: 0;
        z-index: 6;
        pointer-events: none;
        color: #1d1d1f;
    }
    .hall[hidden] {
        display: none;
    }
    .hall-head {
        position: absolute;
        inset: 0 0 auto;
        display: flex;
        align-items: flex-start;
        gap: 1.5rem;
        padding: 1.4rem var(--page-edge);
    }
    .hall-head > * {
        pointer-events: auto;
    }
    .hall-back {
        flex: none;
        padding: 0.55rem 1.1rem;
        border: 1px solid rgb(29 29 31 / 0.25);
        border-radius: 980px;
        background: rgb(255 255 255 / 0.55);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        color: inherit;
        font: inherit;
        font-size: 0.9375rem;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 0.2s;
    }
    .hall-back:hover {
        background: rgb(255 255 255 / 0.85);
    }
    .hall-title h2 {
        margin: 0;
        font-size: 1.375rem;
        font-weight: 600;
        letter-spacing: -0.02em;
    }
    .hall-title p {
        margin: 0.2rem 0 0;
        color: rgb(29 29 31 / 0.6);
        font-size: 0.875rem;
    }
    .hall-full {
        margin-left: auto;
        padding-top: 0.55rem;
        color: inherit;
        font-size: 0.9375rem;
        text-decoration: underline;
        text-underline-offset: 0.2em;
        text-decoration-color: rgb(29 29 31 / 0.3);
    }
    .hall-caption {
        position: absolute;
        left: 50%;
        bottom: 1.8rem;
        translate: -50% 0;
        margin: 0;
        display: flex;
        gap: 0.8rem;
        align-items: baseline;
        white-space: nowrap;
        padding: 0.5rem 1.1rem;
        border-radius: 980px;
        background: rgb(255 255 255 / 0.62);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.08);
        font-size: 0.9375rem;
    }
    .hall-caption:empty {
        display: none;
    }
    .hall-caption :global(span) {
        color: rgb(29 29 31 / 0.55);
        font-size: 0.875rem;
    }

    .lightbox {
        position: fixed;
        inset: 0;
        z-index: 8;
        display: grid;
        place-items: center;
        padding: 4.5rem var(--page-edge) 2rem;
        background: rgb(8 8 10 / 0.92);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        animation: lightbox-in 0.3s var(--spring);
    }
    .lightbox[hidden] {
        display: none;
    }
    @keyframes lightbox-in {
        from {
            opacity: 0;
        }
    }
    .lightbox figure {
        margin: 0;
        display: grid;
        gap: 1rem;
        justify-items: center;
        max-width: min(1200px, 100%);
        max-height: 100%;
    }
    .lightbox img {
        display: block;
        max-width: 100%;
        max-height: calc(100svh - 13rem);
        width: auto;
        height: auto;
        background: #1a1a1c;
        box-shadow: 0 2rem 5rem rgb(0 0 0 / 0.5);
    }
    .lightbox figcaption {
        max-width: 44rem;
        text-align: center;
    }
    .lightbox h3 {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 600;
        letter-spacing: -0.02em;
    }
    .lightbox-meta {
        margin: 0.2rem 0 0.5rem;
        color: var(--color-fg-muted);
        font-size: 0.875rem;
    }
    .lightbox-alt {
        margin: 0;
        color: var(--color-fg-dim);
        font-size: 0.875rem;
        line-height: 1.5;
    }
    .lightbox-close,
    .lightbox-step {
        position: absolute;
        display: grid;
        place-items: center;
        width: 2.75rem;
        height: 2.75rem;
        border: 1px solid var(--color-hairline-strong);
        border-radius: 50%;
        background: rgb(255 255 255 / 0.06);
        color: var(--color-fg);
        font: inherit;
        font-size: 1.25rem;
        cursor: pointer;
    }
    .lightbox-close:hover,
    .lightbox-step:hover {
        background: rgb(255 255 255 / 0.14);
    }
    .lightbox-close {
        top: 1.2rem;
        right: var(--page-edge);
    }
    .lightbox-step {
        top: 50%;
        translate: 0 -50%;
    }
    .lightbox-prev {
        left: var(--page-edge);
    }
    .lightbox-next {
        right: var(--page-edge);
    }

    @media (max-width: 760px) {
        .hall-head {
            flex-wrap: wrap;
            gap: 0.8rem 1rem;
            padding-top: 1rem;
        }
        .hall-title {
            order: 3;
            width: 100%;
        }
        .hall-caption {
            flex-direction: column;
            align-items: center;
            gap: 0.1rem;
        }
        .lightbox-step {
            top: auto;
            bottom: 1.2rem;
            translate: none;
        }
        .room {
            --piano-h: clamp(5.5rem, 14svh, 7.25rem);
        }
        .room-shade {
            background: linear-gradient(0deg, rgb(5 5 6 / 0.85), rgb(5 5 6 / 0) 55%);
        }
        .room:is([data-state="loading"], [data-state="live"]) :is(.chapter-left, .chapter-right, .chapter-hero) {
            left: var(--page-edge);
            right: var(--page-edge);
            top: auto;
            bottom: 7vh;
            translate: none;
        }
        .room:is([data-state="loading"], [data-state="live"]) .chapter-end {
            left: var(--page-edge);
            right: var(--page-edge);
            bottom: 5vh;
        }
    }
</style>

<script>
    import { lifetime } from "../../lib/motion";
    import { initRoomFilm } from "../../lib/room/film";

    const root = document.querySelector<HTMLElement>(".room");
    if (root) initRoomFilm(root, lifetime());
</script>
