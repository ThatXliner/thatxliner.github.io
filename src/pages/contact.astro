---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Contact Me — Bryan Hu" description="Get in touch with Bryan Hu about projects, collaborations, or opportunities.">
    <Nav />
    <main class="contact-page">
        <h1 class="t-display">
            <span class="mask mask-load"><span>Contact <span class="text-fg-muted">me.</span></span></span>
        </h1>
        <p class="t-lede rise" style="animation-delay:160ms">Have a project in mind, an opportunity to share, or just want to say hello?</p>
        <a class="email a-underline rise" style="animation-delay:240ms" href="mailto:thatxliner@gmail.com"><Icon name="lucide:mail" aria-hidden="true" />thatxliner@gmail.com</a>
        <div class="contact-links rise" style="animation-delay:320ms">
            <a class="btn btn-ghost" href="https://github.com/ThatXliner"><Icon name="simple-icons:github" aria-hidden="true" />GitHub <span aria-hidden="true">↗</span></a>
            <a class="btn btn-ghost" href="https://www.linkedin.com/in/thatxliner/"><Icon name="simple-icons:linkedin" aria-hidden="true" />LinkedIn <span aria-hidden="true">↗</span></a>
            <a class="btn btn-ghost" href="/resume.pdf" download="BryanHu_Resume.pdf"><Icon name="lucide:download" aria-hidden="true" />Résumé PDF</a>
        </div>
    </main>
    <Footer />
</Layout>

<style>
    .contact-page {
        max-width: 1320px;
        min-height: calc(100svh - 6rem);
        margin-inline: auto;
        padding: clamp(9rem, 22svh, 14rem) var(--spacing-gutter) 6rem;
    }
    .t-lede {
        max-width: 34ch;
        margin-top: 1.75rem;
    }
    .email {
        display: inline-flex;
        align-items: center;
        gap: 0.625rem;
        margin-top: 2.5rem;
        font-size: clamp(1.25rem, 3.2vw, 2.25rem);
        font-weight: 500;
        letter-spacing: -0.025em;
        overflow-wrap: anywhere;
    }
    .email :global(svg) {
        flex-shrink: 0;
        width: 0.85em;
        height: 0.85em;
        color: var(--color-accent);
    }
    .contact-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.625rem;
        margin-top: 2.25rem;
    }
    .contact-links :global(svg) {
        width: 1rem;
        height: 1rem;
    }
</style>
