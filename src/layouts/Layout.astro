---
import { Font } from "astro:assets";
import "../styles/global.css";

// `noanim` is only ever set by the /preview QA route, so scroll-driven
// animations render settled in static screenshots.
interface Props {
    noanim?: boolean;
}
const { noanim } = Astro.props;
---

<!doctype html>
<html lang="en" data-noanim={noanim ? "" : undefined}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#000000" />
        <meta name="color-scheme" content="dark" />
        <title>Bryan Hu — Founder & Developer</title>
        <meta
            name="description"
            content="Bryan Hu is a founder and full-stack developer building Billion (civic intelligence) and Quillium (version control for prose) — plus open-source Python tooling, award-winning robotics software, and creative work."
        />
        <Font cssVariable="--font-sans" preload />
        <script
            defer
            src="https://cloud.umami.is/script.js"
            data-website-id="2be13475-b999-4286-a9b3-6142c2df6136"></script>
    </head>
    <body>
        <slot />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        min-height: 100%;
    }
</style>
