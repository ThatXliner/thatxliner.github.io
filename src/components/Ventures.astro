---
import VenturesSection from "./ui/VenturesSection";
import ScrubTitle from "./ui/ScrubTitle";
---

<div class="w-full py-16 md:py-24 px-6" id="building">
    <h1
        class="pointer-events-none text-center text-4xl sm:text-5xl md:text-6xl font-bold mb-2"
    >
        <ScrubTitle client:visible text="What I'm Building" />
    </h1>
    <p
        class="text-center text-sm uppercase tracking-[0.25em] text-gray-500 mb-12 md:mb-16"
    >
        Founder &middot; Two products in flight
    </p>

    <VenturesSection client:only />
</div>
