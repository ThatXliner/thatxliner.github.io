---
import { Image } from "astro:assets";
import { LightRays } from "./ui/light-rays";
import HeroScene from "./ui/three/HeroScene";
import me from "../assets/me_stand.png";
import { Icon } from "astro-icon/components";

const tools = [
    "logos:typescript-icon",
    "logos:python",
    "simple-icons:rust",
    "logos:react",
    "logos:svelte-icon",
    "logos:nextjs-icon",
    "logos:java",
    "vscode-icons:file-type-cpp3",
    "skill-icons:sqlite",
    "simple-icons:arduino",
];

const socials = [
    { icon: "mdi:github", href: "https://github.com/ThatXliner", label: "GitHub" },
    { icon: "lucide:pen-line", href: "https://bryanhu.com/blog/", label: "Blog" },
    { icon: "simple-icons:discord", href: "https://discord.gg/7YHfbBUh4n", label: "Discord" },
    { icon: "lucide:instagram", href: "https://www.instagram.com/icliptheworld", label: "Instagram" },
    { icon: "lucide:mail", href: "mailto:thatxliner@gmail.com", label: "Email" },
];

// entrance animation helper — fill-mode-backwards keeps elements hidden
// until their delay elapses
const enter =
    "animate-in fade-in slide-in-from-bottom-4 duration-700 fill-mode-backwards motion-reduce:animate-none";
---

<div class="relative min-h-screen w-full overflow-hidden">
    <HeroScene client:only />

    <div
        class="relative z-10 mx-auto flex min-h-screen max-w-6xl flex-col justify-center px-6 pb-16 pt-28 md:px-10"
    >
        <div class="grid items-center gap-10 md:grid-cols-[1.15fr_0.85fr] md:gap-16">
            <!-- ── Left: the pitch ── -->
            <div class="scroll-exit-fast">
                <p
                    class:list={[enter, "text-xs sm:text-sm uppercase tracking-[0.3em] text-sky-300/80 mb-5"]}
                    style="animation-delay: 0ms"
                >
                    Hi, I'm Bryan Hu
                </p>

                <h1
                    class="text-5xl sm:text-6xl lg:text-7xl font-bold leading-[1.04] tracking-tight text-white"
                >
                    <span class:list={[enter, "block"]} style="animation-delay: 120ms">
                        I turn ideas into
                    </span>
                    <span
                        class:list={[
                            enter,
                            "block bg-[linear-gradient(90deg,var(--color-sky-300),var(--color-purple-300),var(--color-amber-300),var(--color-sky-300))] bg-[length:300%_auto] animate-gradient motion-reduce:animate-none bg-clip-text text-transparent pb-2",
                        ]}
                        style="animation-delay: 260ms"
                    >
                        shipped products.
                    </span>
                </h1>

                <p
                    class:list={[enter, "mt-6 max-w-xl text-base sm:text-lg leading-relaxed text-gray-400"]}
                    style="animation-delay: 400ms"
                >
                    I'm the founder of two products in flight, an open-source
                    author, and an award-winning robotics programmer; when the
                    laptop closes, I'm a photographer, camera operator, and
                    musician.
                </p>

                <!-- now building -->
                <div
                    class:list={[enter, "mt-8 flex flex-wrap items-center gap-3"]}
                    style="animation-delay: 520ms"
                >
                    <span class="text-xs uppercase tracking-[0.25em] text-gray-500">
                        Now building
                    </span>
                    <a
                        href="https://www.billion-news.app/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group inline-flex items-center gap-2 rounded-full border border-sky-500/25 bg-sky-500/10 px-4 py-1.5 text-sm font-medium text-sky-300 transition-colors hover:bg-sky-500/20 hover:border-sky-400/40"
                    >
                        <span class="relative flex h-1.5 w-1.5">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-60"></span>
                            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-sky-400"></span>
                        </span>
                        Billion
                        <Icon
                            name="lucide:arrow-up-right"
                            size={13}
                            class="opacity-50 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                        />
                    </a>
                    <a
                        href="https://quillium.bryanhu.com/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group inline-flex items-center gap-2 rounded-full border border-amber-500/25 bg-amber-500/10 px-4 py-1.5 text-sm font-medium text-amber-300 transition-colors hover:bg-amber-500/20 hover:border-amber-400/40"
                    >
                        <span class="relative flex h-1.5 w-1.5">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-60"></span>
                            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-amber-400"></span>
                        </span>
                        Quillium
                        <Icon
                            name="lucide:arrow-up-right"
                            size={13}
                            class="opacity-50 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                        />
                    </a>
                </div>

                <!-- CTAs -->
                <div
                    class:list={[enter, "mt-8 flex flex-wrap items-center gap-4"]}
                    style="animation-delay: 640ms"
                >
                    <a
                        href="#building"
                        class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 text-sm font-semibold text-gray-950 shadow-lg shadow-white/10 transition-all duration-200 hover:scale-[1.03] hover:bg-gray-100"
                    >
                        See what I'm building
                        <Icon name="lucide:arrow-down" size={16} />
                    </a>
                    <a
                        href="/resume.pdf"
                        download="BryanHu_Resume.pdf"
                        class="inline-flex items-center gap-2 rounded-lg border border-white/15 bg-white/5 px-6 py-3 text-sm font-medium text-white backdrop-blur-sm transition-all duration-200 hover:scale-[1.03] hover:bg-white/10"
                    >
                        <Icon name="lucide:download" size={16} />
                        Résumé
                    </a>
                    <div class="flex items-center gap-1 sm:ml-2">
                        {
                            socials.map((social) => (
                                <a
                                    href={social.href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    aria-label={social.label}
                                    class="rounded-lg p-2.5 text-gray-500 transition-colors hover:text-white hover:bg-white/10"
                                >
                                    <Icon name={social.icon} size={19} />
                                </a>
                            ))
                        }
                    </div>
                </div>
            </div>

            <!-- ── Right: the person ── -->
            <div class="scroll-exit-slow">
            <div
                class="animate-in fade-in slide-in-from-right-8 duration-700 fill-mode-backwards motion-reduce:animate-none relative mx-auto w-full max-w-sm md:max-w-none"
                style="animation-delay: 350ms"
            >
                <div
                    class="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-b from-white/[0.07] via-white/[0.03] to-transparent"
                >
                    <div
                        class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_20%,rgba(160,210,255,0.12),transparent_65%)]"
                    >
                    </div>
                    <Image
                        src={me}
                        draggable="false"
                        alt="Bryan Hu"
                        class="relative mx-auto h-[380px] w-auto select-none object-contain pt-6 md:h-[480px] mask-[linear-gradient(to_bottom,black_82%,transparent)]"
                        width="480"
                    />
                </div>
            </div>
            </div>
        </div>

        <!-- ── Bottom: tool strip + scroll cue ── -->
        <div
            class:list={[enter, "mt-16 flex flex-col items-center gap-6 md:mt-20"]}
            style="animation-delay: 800ms"
        >
            <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-3">
                <span class="text-[10px] uppercase tracking-[0.3em] text-gray-600">
                    Ships with
                </span>
                {
                    tools.map((tool) => (
                        <Icon
                            name={tool}
                            size={22}
                            class="opacity-35 saturate-0 transition-all duration-300 hover:opacity-100 hover:saturate-100"
                        />
                    ))
                }
            </div>
        </div>
    </div>

    <LightRays />
</div>
