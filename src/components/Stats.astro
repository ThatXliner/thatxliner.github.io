---
import { Icon } from "astro-icon/components";
import StatsSection from "./ui/StatsSection";
import type { Stat } from "./ui/StatsSection";
import {
    getAllRepositories,
    getForkedRepositories,
    getGitHubStats,
} from "@/lib/github";

const repositories = await getAllRepositories();
const forks = await getForkedRepositories();
const gh = await getGitHubStats();

const totalStars = repositories.reduce((sum, repo) => sum + repo.starCount, 0);

const stats: Stat[] = [
    {
        value: totalStars,
        label: "GitHub stars",
        sublabel: "across my open-source work",
        icon: "octicon:star-24",
        href: "https://github.com/ThatXliner",
    },
    {
        value: gh.totalContributions,
        label: "contributions",
        sublabel: "on GitHub in the last year",
        icon: "octicon:graph-24",
        href: "https://github.com/ThatXliner",
    },
    {
        value: gh.totalRepos,
        label: "repositories",
        sublabel: "created and maintained",
        icon: "octicon:repo-24",
        href: "https://github.com/ThatXliner?tab=repositories",
    },
    {
        value: forks.length,
        label: "upstream projects",
        sublabel: "with my PRs merged",
        icon: "octicon:git-merge-24",
    },
    {
        value: 8,
        label: "competition awards",
        sublabel: "FRC robotics + Congressional App Challenge",
        icon: "lucide:trophy",
    },
    {
        value: 2,
        prefix: "Top ",
        suffix: "%",
        label: "picoCTF 2026",
        sublabel: "174th of 8,747 nationally",
        icon: "lucide:shield",
        href: "https://picoctf.org/",
    },
];

const allAwards = [
    {
        label: "3rd Place — Congressional App Challenge 2025 (CA-19)",
        icon: "lucide:award",
        year: 2025,
        url: "https://www.congressionalappchallenge.us/",
    },
    {
        label: "USACO Silver",
        icon: "lucide:code",
        url: "https://usaco.org/",
    },
    {
        label: "picoCTF — 174th / 8,747",
        icon: "lucide:shield",
        year: 2026,
        url: "https://picoctf.org/",
    },
];

const frcAwards = [
    {
        label: "Creativity Award — Daly Division (Champs)",
        year: 2025,
        url: "https://www.thebluealliance.com/event/2025dal#awards",
    },
    {
        label: "Excellence in Engineering — Contra Costa Regional",
        year: 2025,
        url: "https://www.thebluealliance.com/event/2025capt#awards",
    },
    {
        label: "Innovation in Control — Ventura County Regional",
        year: 2025,
        url: "https://www.thebluealliance.com/event/2025cave#awards",
    },
    {
        label: "Engineering Inspiration — San Francisco Regional",
        year: 2025,
        url: "https://www.thebluealliance.com/event/2025casf#awards",
    },
    {
        label: "Judges' Award — Capital City Classic",
        year: 2025,
        url: "https://www.thebluealliance.com/event/2025cacc#awards",
    },
    {
        label: "Regional Finalists — Silicon Valley Regional",
        year: 2024,
        url: "https://www.thebluealliance.com/event/2024casj#awards",
    },
    {
        label: "Engineering Inspiration — Arizona Valley Regional",
        year: 2024,
        url: "https://www.thebluealliance.com/event/2024azva#awards",
    },
];
---

<div class="w-full py-16 md:py-24 px-6" id="stats">
    <h1
        class="pointer-events-none text-center text-4xl sm:text-5xl md:text-6xl font-bold mb-2"
    >
        By the Numbers
    </h1>
    <p
        class="text-center text-sm uppercase tracking-[0.25em] text-gray-500 mb-12 md:mb-16"
    >
        Stats &amp; achievements
    </p>

    <StatsSection client:only stats={stats} />

    <details class="max-w-3xl mx-auto mt-12 group">
        <summary
            class="flex items-center justify-center gap-2 cursor-pointer text-sm font-medium text-gray-400 hover:text-amber-300 transition-colors select-none"
        >
            <Icon name="lucide:trophy" class="w-4 h-4" />
            Full award list ({allAwards.length + frcAwards.length})
            <Icon
                name="lucide:chevron-down"
                class="w-4 h-4 transition-transform group-open:rotate-180"
            />
        </summary>
        <div class="flex flex-wrap justify-center gap-2 mt-5">
            {
                allAwards.map((award) => (
                    <a
                        href={award.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium bg-amber-500/10 text-amber-300/80 border border-amber-500/15 hover:bg-amber-500/20 hover:border-amber-500/30 transition-all duration-200"
                    >
                        <Icon name={award.icon} class="w-3 h-3" />
                        {award.label}
                        {award.year && (
                            <span class="text-amber-300/40">{award.year}</span>
                        )}
                    </a>
                ))
            }
            {
                frcAwards.map((award) => (
                    <a
                        href={award.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium bg-amber-500/10 text-amber-300/80 border border-amber-500/15 hover:bg-amber-500/20 hover:border-amber-500/30 transition-all duration-200"
                    >
                        <Icon name="simple-icons:first" class="w-3 h-3" />
                        {award.label}
                        <span class="text-amber-300/40">{award.year}</span>
                    </a>
                ))
            }
        </div>
    </details>
</div>
