---
import { Marquee } from "./ui/marquee";
import { Icon } from "astro-icon/components";
import Repo from "./ui/Repo";
import ProjectGrid from "./ui/ProjectGrid";
import ScrubTitle from "./ui/ScrubTitle";
import { projects } from "@/data/projects";
import { getAllRepositories, getForkedRepositories } from "@/lib/github";

const repositories = await getAllRepositories();
const forks = await getForkedRepositories();

const firstRow = repositories.slice(0, repositories.length / 2);
const secondRow = repositories.slice(repositories.length / 2);

const forksFirstRow = forks.slice(0, forks.length / 2);
const forksSecondRow = forks.slice(forks.length / 2);
---

<div class="w-full py-16 md:py-24" id="code">
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-center mb-2">
        <a
            href="https://github.com/ThatXliner?tab=repositories"
            class="hover:text-gray-300 transition-colors"
            >Open Source <Icon
                name="lucide:external-link"
                class="inline w-8 h-8 opacity-40"
            /></a
        >
    </h1>
    <p
        class="text-center text-sm uppercase tracking-[0.25em] text-gray-500 mb-12"
    >
        Repositories I've started myself
    </p>

    <div
        class="marquee-skew relative flex w-full flex-col items-center justify-center overflow-hidden mt-8 [transform:skewX(var(--scroll-skew,0deg))] will-change-transform"
    >
        <Marquee client:only pauseOnHover className="[--duration:90s]">
            {firstRow.map((review) => <Repo client:only {...review} />)}
        </Marquee>
        <Marquee client:only reverse pauseOnHover className="[--duration:90s]">
            {secondRow.map((review) => <Repo client:only {...review} />)}
        </Marquee>
        <div
            class="from-background pointer-events-none absolute inset-y-0 left-0 w-1/4 bg-linear-to-r"
        >
        </div>
        <div
            class="from-background pointer-events-none absolute inset-y-0 right-0 w-1/4 bg-linear-to-l"
        >
        </div>
    </div>

    <p
        class="text-center text-sm uppercase tracking-[0.25em] text-gray-500 mt-16"
    >
        Forks &mdash; my contributions upstream
    </p>

    <div
        class="marquee-skew relative flex w-full flex-col items-center justify-center overflow-hidden mt-8 [transform:skewX(var(--scroll-skew,0deg))] will-change-transform"
    >
        <Marquee client:only pauseOnHover className="[--duration:120s]">
            {forksFirstRow.map((review) => <Repo client:only {...review} />)}
        </Marquee>
        <Marquee client:only reverse pauseOnHover className="[--duration:120s]">
            {forksSecondRow.map((review) => <Repo client:only {...review} />)}
        </Marquee>
        <div
            class="from-background pointer-events-none absolute inset-y-0 left-0 w-1/4 bg-gradient-to-r"
        >
        </div>
        <div
            class="from-background pointer-events-none absolute inset-y-0 right-0 w-1/4 bg-gradient-to-l"
        >
        </div>
    </div>

    <div class="px-6" id="projects">
        <h2
            class="text-3xl sm:text-4xl font-bold text-center mt-24 mb-2 pointer-events-none"
        >
            <ScrubTitle client:visible text="Featured Work" />
        </h2>
        <p
            class="text-center text-xs sm:text-sm uppercase tracking-[0.15em] sm:tracking-[0.25em] text-gray-500 mb-12"
        >
            A closer look at my most notable repos
        </p>

        <ProjectGrid client:only projects={projects} />
    </div>
</div>

<script>
    // Scroll velocity shears the marquee rows; they spring back at rest.
    // Runs only while the section is on screen.
    const section = document.getElementById("code");
    const rows = document.querySelectorAll<HTMLElement>(".marquee-skew");
    const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    if (section && rows.length > 0 && !reducedMotion) {
        let lastY = window.scrollY;
        let velocity = 0;
        let raf = 0;
        let running = false;

        const tick = () => {
            const y = window.scrollY;
            const raw = Math.max(-1, Math.min(1, (y - lastY) / 28));
            lastY = y;
            velocity += (raw - velocity) * 0.08;
            const skew = velocity * 3.5;
            rows.forEach((row) =>
                row.style.setProperty("--scroll-skew", `${skew.toFixed(3)}deg`),
            );
            if (running) raf = requestAnimationFrame(tick);
        };

        const observer = new IntersectionObserver(([entry]) => {
            if (entry.isIntersecting && !running) {
                running = true;
                lastY = window.scrollY;
                raf = requestAnimationFrame(tick);
            } else if (!entry.isIntersecting && running) {
                running = false;
                cancelAnimationFrame(raf);
            }
        });
        observer.observe(section);
    }
</script>
