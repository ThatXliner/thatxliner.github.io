---
// Section links are page-absolute (`/#work`) so the same nav works from
// /apps as well as the home page. On the home page these still resolve as
// same-document fragment navigation, so nothing reloads.
const links = [
    { label: "Building", href: "/#building", section: "building" },
    { label: "Apps", href: "/apps", path: "/apps" },
    { label: "Work", href: "/#work", section: "work" },
    { label: "Story", href: "/#story", section: "story", minWidth: "md" },
    {
        label: "Off the clock",
        href: "/#creative",
        section: "creative",
        minWidth: "md",
    },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header
    id="nav"
    class="fixed top-0 z-50 w-full border-b border-transparent transition-colors duration-300 data-[scrolled]:border-hairline data-[scrolled]:bg-void/72 data-[scrolled]:backdrop-blur-xl"
>
    <div
        class="mx-auto flex h-12 max-w-[1180px] items-center justify-between px-gutter"
    >
        <a
            href="/"
            class="text-[0.9375rem] font-semibold tracking-[-0.015em] transition-opacity hover:opacity-70"
            >Bryan Hu</a
        >

        <nav class="flex items-center gap-5 sm:gap-7">
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        data-section={link.section}
                        data-active={link.path === path ? "" : undefined}
                        class:list={[
                            "text-[0.8125rem] text-fg-muted transition-colors hover:text-fg data-[active]:text-fg",
                            link.minWidth === "md" && "hidden md:inline",
                        ]}
                    >
                        {link.label}
                    </a>
                ))
            }
            <a
                href="/#contact"
                class="text-[0.8125rem] text-accent transition-opacity hover:opacity-70"
                >Contact</a
            >
        </nav>
    </div>
</header>

<script>
    // Two tiny behaviours, no framework: the bar materializes once you leave
    // the hero, and the current section's link brightens.
    const nav = document.getElementById("nav");

    const onScroll = () => {
        if (window.scrollY > 24) nav?.setAttribute("data-scrolled", "");
        else nav?.removeAttribute("data-scrolled");
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    // Section highlighting only applies on pages that actually contain the
    // sections; elsewhere (e.g. /apps) the server-rendered active state stands.
    const sectionLinks = Array.from(
        document.querySelectorAll<HTMLElement>("[data-section]"),
    );
    const observed = sectionLinks
        .map((link) => ({
            link,
            el: document.getElementById(link.dataset.section!),
        }))
        .filter((pair): pair is { link: HTMLElement; el: HTMLElement } =>
            Boolean(pair.el),
        );

    if (observed.length > 0) {
        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (!entry.isIntersecting) continue;
                    for (const pair of observed) {
                        if (pair.el === entry.target) {
                            pair.link.setAttribute("data-active", "");
                        } else {
                            pair.link.removeAttribute("data-active");
                        }
                    }
                }
            },
            { rootMargin: "-40% 0px -55% 0px" },
        );
        observed.forEach((pair) => observer.observe(pair.el));
    }
</script>
