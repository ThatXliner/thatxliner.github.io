---
const links = [
    { label: "Building", href: "#building" },
    { label: "Work", href: "#work" },
    { label: "Story", href: "#story" },
    { label: "Off the clock", href: "#creative" },
];
---

<header
    id="nav"
    class="fixed top-0 z-50 w-full border-b border-transparent transition-colors duration-300 data-[scrolled]:border-hairline data-[scrolled]:bg-void/72 data-[scrolled]:backdrop-blur-xl"
>
    <div
        class="mx-auto flex h-12 max-w-[1180px] items-center justify-between px-gutter"
    >
        <a
            href="#top"
            class="text-[0.9375rem] font-semibold tracking-[-0.015em] transition-opacity hover:opacity-70"
            >Bryan Hu</a
        >

        <nav class="flex items-center gap-5 sm:gap-7">
            {
                links.map((link, i) => (
                    <a
                        href={link.href}
                        data-navlink={link.href}
                        class:list={[
                            "text-[0.8125rem] text-fg-muted transition-colors hover:text-fg data-[active]:text-fg",
                            i > 1 && "hidden sm:inline",
                        ]}
                    >
                        {link.label}
                    </a>
                ))
            }
            <a
                href="#contact"
                class="text-[0.8125rem] text-accent transition-opacity hover:opacity-70"
                >Contact</a
            >
        </nav>
    </div>
</header>

<script>
    // Two tiny behaviours, no framework: the bar materializes once you leave
    // the hero, and the current section's link brightens.
    const nav = document.getElementById("nav");
    const navLinks = Array.from(
        document.querySelectorAll<HTMLElement>("[data-navlink]"),
    );

    const onScroll = () => {
        if (window.scrollY > 24) nav?.setAttribute("data-scrolled", "");
        else nav?.removeAttribute("data-scrolled");
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    const sections = navLinks
        .map((link) => document.querySelector(link.dataset.navlink!))
        .filter((el): el is Element => el !== null);

    if (sections.length > 0) {
        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (!entry.isIntersecting) continue;
                    for (const link of navLinks) {
                        if (link.dataset.navlink === `#${entry.target.id}`) {
                            link.setAttribute("data-active", "");
                        } else {
                            link.removeAttribute("data-active");
                        }
                    }
                }
            },
            { rootMargin: "-40% 0px -55% 0px" },
        );
        sections.forEach((section) => observer.observe(section));
    }
</script>
