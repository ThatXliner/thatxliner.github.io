<div class="playable-trombone" aria-label="Interactive trombone" role="group">
    <svg viewBox="0 0 620 140" fill="none" aria-hidden="true" class="trombone-drawing">
        <defs>
            <linearGradient id="trombone-brass" x1="0%" y1="0%" x2="0%" y2="100%"><stop stop-color="#8f612b" /><stop offset=".22" stop-color="#e9c778" /><stop offset=".44" stop-color="#fff1bc" /><stop offset=".65" stop-color="#d3a24e" /><stop offset="1" stop-color="#996628" /></linearGradient>
            <linearGradient id="trombone-bell" x1="0%" y1="0%" x2="0%" y2="100%"><stop stop-color="#b9873e" /><stop offset=".3" stop-color="#f0d495" /><stop offset=".5" stop-color="#fff3c8" /><stop offset=".7" stop-color="#cf9d4d" /><stop offset="1" stop-color="#8d5e2a" /></linearGradient>
        </defs>
        <g stroke-linecap="round" stroke-linejoin="round">
            <!-- The tuning bow sits behind the player; bell and hand slide face forward. -->
            <path d="M165 86H44C8 86 8 43 44 43H156" stroke="#594328" stroke-width="9" />
            <path d="M165 86H44C8 86 8 43 44 43H156" stroke="url(#trombone-brass)" stroke-width="6" />
            <path d="M128 39C176 39 211 39 236 34C254 30 269 19 279 8L279 78C263 63 251 57 234 53C208 47 174 47 128 47Z" fill="url(#trombone-bell)" stroke="#73512d" stroke-width="1.5" />
            <ellipse cx="279" cy="43" rx="7" ry="35" fill="#9e713a" stroke="#6b4c2c" stroke-width="1.5" />
            <ellipse cx="280" cy="43" rx="3.5" ry="30" fill="#3e3023" />
            <path d="M148 41Q247 44 271 17" stroke="#fff1bf" stroke-width="1.5" />
            <path d="M83 47V81" stroke="#8f6b35" stroke-width="4" />
            <circle cx="83" cy="65" r="7" fill="#d5b775" stroke="#73512d" stroke-width="1.3" />
            <!-- Mouthpiece enters the upper slide tube; lower tube returns to the bell. -->
            <path d="M95 101H352M129 123H352" stroke="#68717a" stroke-width="4" />
            <path d="M95 100H352M129 122H352" stroke="#edf0f2" stroke-width="1.5" />
            <path d="M152 123V93Q152 86 160 86H166" stroke="#73512d" stroke-width="6" />
            <path d="M152 123V93Q152 86 160 86H166" stroke="#d6af66" stroke-width="3.5" />
            <path d="M129 101V123" stroke="#b49763" stroke-width="4" />
            <path d="M97 98H86L80 94H74V108H80L86 104H97Z" fill="#dce0e3" stroke="#68717a" stroke-width="1.2" />
            <g class="trombone-slide">
                <!-- A wider invisible hit area, so the slide is easy to grab. -->
                <rect x="166" y="88" width="256" height="50" fill="transparent" stroke="none" />
                <path d="M166 101H404Q415 101 415 112T404 123H166" stroke="#705431" stroke-width="6" />
                <path d="M166 101H404Q415 101 415 112T404 123H166" stroke="url(#trombone-brass)" stroke-width="4" />
                <path d="M173 100H402M173 122H402" stroke="#fff0b5" stroke-width=".8" />
                <path d="M183 102V122" stroke="#967846" stroke-width="4" />
                <path d="M183 103V121" stroke="#f2d498" stroke-width="1.5" />
                <path d="M166 98V104M166 120V126M172 98V104M172 120V126" stroke="#8c744b" stroke-width="1.5" />
                <path d="M401 127L406 132M400 132H410" stroke="#836f50" stroke-width="1.5" />
            </g>
        </g>
    </svg>
    <div class="trombone-controls">
        <label for="trombone-slide">Slide</label>
        <input id="trombone-slide" type="range" min="0" max="6" step="0.01" value="0" aria-label="Trombone slide position" />
    </div>
    <div class="instrument-panel">
        <button type="button" class="trombone-play btn btn-ghost" aria-pressed="false">Play <span aria-hidden="true">♫</span></button>
        <output aria-live="off" class="tnum">B♭3</output>
        <div class="partial-controls">
            <span class="partial-name t-caption">Partial</span>
            <div class="partial-stepper">
                <button type="button" class="partial-down" aria-label="Lower partial">−</button>
                <span class="partial-label tnum" aria-live="polite">4</span>
                <button type="button" class="partial-up" aria-label="Higher partial">+</button>
            </div>
        </div>
    </div>
    <p class="t-caption trombone-hint">Drag the slide to play, or hold Play.</p>
    <small class="t-caption">This is not indicative of my actual playing range.</small>
</div>

<script>
    import { lifetime, Spring } from "../lib/motion";

    const instrument = document.querySelector<HTMLElement>(".playable-trombone");
    if (instrument) {
        const signal = lifetime();
        const button = instrument.querySelector<HTMLButtonElement>(".trombone-play")!;
        const slider = instrument.querySelector<HTMLInputElement>("input")!;
        const slide = instrument.querySelector<SVGGElement>(".trombone-slide")!;
        const drawing = instrument.querySelector<SVGSVGElement>("svg")!;
        const output = instrument.querySelector("output")!;
        const down = instrument.querySelector<HTMLButtonElement>(".partial-down")!;
        const up = instrument.querySelector<HTMLButtonElement>(".partial-up")!;
        const partialLabel = instrument.querySelector<HTMLElement>(".partial-label")!;
        const notes = ["C", "D♭", "D", "E♭", "E", "F", "G♭", "G", "A♭", "A", "B♭", "B"];
        // ViewBox units per semitone: at full travel the sleeve stops just short
        // of the end of the inner tubes, as a real one does.
        const TRAVEL = 30;
        let partial = 4;

        let context: AudioContext | undefined;
        let voice: { osc: OscillatorNode; gain: GainNode; filter: BiquadFilterNode } | undefined;
        let releaseTimer: ReturnType<typeof setTimeout> | undefined;

        const noteName = (frequency: number) => {
            const midi = Math.round(69 + 12 * Math.log2(frequency / 440));
            return notes[midi % 12] + (Math.floor(midi / 12) - 1);
        };
        const pitch = () => 58.27047 * partial * Math.pow(2, -position.value / 12);

        // The slide has mass, and the pitch comes from where the slide actually
        // is. A fast pull overshoots a little, and you hear it as well as see it.
        const position = new Spring(0, { stiffness: 240, damping: 27, precision: 0.002 }, () => {
            slide.setAttribute("transform", `translate(${(position.value * TRAVEL).toFixed(2)} 0)`);
            output.textContent = noteName(pitch());
            slider.setAttribute("aria-valuetext", noteName(pitch()));
            if (context && voice) voice.osc.frequency.setTargetAtTime(pitch(), context.currentTime, 0.012);
        });

        function stop() {
            clearTimeout(releaseTimer);
            if (voice && context) {
                // A first touch can grant audio activation only on release.
                void context.resume();
                const old = voice;
                voice = undefined;
                const now = context.currentTime;
                old.gain.gain.cancelScheduledValues(now);
                old.gain.gain.setTargetAtTime(0, now, 0.035);
                old.osc.stop(now + 0.2);
                old.osc.onended = () => {
                    old.osc.disconnect();
                    old.gain.disconnect();
                    old.filter.disconnect();
                };
            }
            button.setAttribute("aria-pressed", "false");
            instrument!.classList.remove("playing");
        }

        function play() {
            if (voice) return;
            context ??= new AudioContext();
            void context.resume();
            const osc = context.createOscillator();
            const gain = context.createGain();
            const filter = context.createBiquadFilter();
            osc.type = "sawtooth";
            osc.frequency.value = pitch();
            filter.type = "lowpass";
            filter.frequency.value = 1400;
            filter.Q.value = 0.6;
            osc.connect(filter);
            filter.connect(gain);
            gain.connect(context.destination);
            gain.gain.setValueAtTime(0, context.currentTime);
            gain.gain.linearRampToValueAtTime(0.09, context.currentTime + 0.08);
            osc.start();
            voice = { osc, gain, filter };
            button.setAttribute("aria-pressed", "true");
            instrument!.classList.add("playing");
            releaseTimer = setTimeout(stop, 10000);
        }

        button.addEventListener(
            "pointerdown",
            (event) => {
                if (event.button !== 0) return;
                event.preventDefault();
                button.setPointerCapture(event.pointerId);
                play();
            },
            { signal },
        );
        button.addEventListener("pointerup", stop, { signal });
        button.addEventListener("pointercancel", stop, { signal });
        button.addEventListener("lostpointercapture", stop, { signal });
        button.addEventListener(
            "keydown",
            (event) => {
                if ([" ", "Enter"].includes(event.key)) {
                    event.preventDefault();
                    if (!event.repeat) play();
                }
            },
            { signal },
        );
        button.addEventListener(
            "keyup",
            (event) => {
                if ([" ", "Enter"].includes(event.key)) {
                    event.preventDefault();
                    stop();
                }
            },
            { signal },
        );
        button.addEventListener(
            "click",
            (event) => {
                if (event.detail === 0 && !voice) {
                    play();
                    clearTimeout(releaseTimer);
                    releaseTimer = setTimeout(stop, 650);
                }
            },
            { signal },
        );

        const follow = () => position.to(Number(slider.value));
        slider.addEventListener("input", follow, { signal });
        slider.addEventListener("pointerdown", play, { signal });
        slider.addEventListener("pointerup", stop, { signal });
        slider.addEventListener("pointercancel", stop, { signal });
        window.addEventListener("pointerup", stop, { signal });
        window.addEventListener("pointercancel", stop, { signal });
        slider.addEventListener(
            "keydown",
            (event) => {
                if (event.key.startsWith("Arrow")) play();
            },
            { signal },
        );
        slider.addEventListener("keyup", stop, { signal });

        // The slide itself can be pulled. Vertical swipes still scroll the page.
        let grab: { id: number; x: number; value: number } | undefined;
        const unitsPerPixel = () => 620 / drawing.getBoundingClientRect().width / TRAVEL;
        slide.addEventListener(
            "pointerdown",
            (event) => {
                if (event.button !== 0) return;
                grab = { id: event.pointerId, x: event.clientX, value: Number(slider.value) };
                slide.setPointerCapture(event.pointerId);
                play();
            },
            { signal },
        );
        slide.addEventListener(
            "pointermove",
            (event) => {
                if (grab?.id !== event.pointerId) return;
                const value = grab.value + (event.clientX - grab.x) * unitsPerPixel();
                slider.value = String(Math.min(6, Math.max(0, value)));
                follow();
            },
            { signal },
        );
        const letGo = (event: PointerEvent) => {
            if (grab?.id !== event.pointerId) return;
            grab = undefined;
            stop();
        };
        slide.addEventListener("pointerup", letGo, { signal });
        slide.addEventListener("pointercancel", letGo, { signal });

        function setPartial(value: number) {
            partial = value;
            partialLabel.textContent = String(partial);
            down.disabled = partial === 2;
            up.disabled = partial === 6;
            output.textContent = noteName(pitch());
            slider.setAttribute("aria-valuetext", noteName(pitch()));
            if (context && voice) voice.osc.frequency.setTargetAtTime(pitch(), context.currentTime, 0.025);
        }
        down.addEventListener("click", () => setPartial(Math.max(2, partial - 1)), { signal });
        up.addEventListener("click", () => setPartial(Math.min(6, partial + 1)), { signal });
        setPartial(partial);

        window.addEventListener("blur", stop, { signal });
        document.addEventListener(
            "visibilitychange",
            () => {
                if (document.hidden) stop();
            },
            { signal },
        );
        const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) stop();
        });
        observer.observe(instrument);
        signal.addEventListener("abort", () => {
            stop();
            observer.disconnect();
            void context?.close();
        });
        instrument.dataset.ready = "";
    }
</script>

<style>
    .playable-trombone {
        width: 100%;
    }
    .trombone-drawing {
        touch-action: pan-y;
        display: block;
        width: 100%;
        height: auto;
        overflow: visible;
    }
    .trombone-slide {
        cursor: grab;
        touch-action: pan-y;
    }
    .trombone-slide:active {
        cursor: grabbing;
    }
    .trombone-controls {
        display: grid;
        grid-template-columns: auto 1fr;
        align-items: center;
        gap: 0.875rem;
        margin-top: 1rem;
        font-size: 0.875rem;
        color: var(--color-fg-muted);
    }
    input {
        width: 100%;
        min-width: 0;
        min-height: 2.75rem;
        margin: 0;
        accent-color: var(--color-accent);
        cursor: pointer;
    }
    .instrument-panel {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem 1.5rem;
        margin-top: 0.75rem;
    }
    .trombone-play {
        touch-action: none;
        -webkit-user-select: none;
        user-select: none;
    }
    .playing .trombone-play {
        background: var(--color-accent);
        border-color: var(--color-accent);
        color: #08080a;
    }
    output {
        min-width: 3rem;
        font-family: var(--font-sans);
        font-size: 1.25rem;
        line-height: 1;
        color: var(--color-accent);
    }
    .partial-controls {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-left: auto;
    }
    .partial-stepper {
        display: flex;
        align-items: center;
        gap: 0.625rem;
    }
    .partial-stepper button {
        width: 2.75rem;
        height: 2.75rem;
        border: 1px solid var(--color-hairline-strong);
        border-radius: 999px;
        font-size: 1.125rem;
        color: var(--color-fg);
        cursor: pointer;
        transition:
            border-color 0.2s ease,
            transform 0.5s var(--spring-lively);
    }
    .partial-stepper button:hover:not(:disabled) {
        border-color: var(--color-fg-muted);
    }
    .partial-stepper button:active:not(:disabled) {
        transform: scale(0.92);
        transition-duration: 0.2s, 0.05s;
    }
    .partial-stepper button:disabled {
        opacity: 0.32;
        cursor: default;
    }
    .partial-label {
        min-width: 1ch;
        text-align: center;
    }
    .trombone-hint {
        margin: 1rem 0 0;
    }
    small {
        display: block;
        margin-top: 0.25rem;
    }
    :global(html:not(.js)) .instrument-panel,
    :global(html:not(.js)) .trombone-controls,
    :global(html:not(.js)) .trombone-hint,
    :global(html:not(.js)) .playable-trombone small {
        display: none;
    }
    @media (max-width: 30rem) {
        .partial-controls {
            margin-left: 0;
        }
    }
</style>
