---
import StorySection from "./ui/StorySection";
---

<div class="w-full py-16 md:py-24 px-6" id="story">
    <h1
        class="pointer-events-none text-center text-4xl sm:text-5xl md:text-6xl font-bold mb-2"
    >
        The Story So Far
    </h1>
    <p
        class="text-center text-sm uppercase tracking-[0.25em] text-gray-500 mb-12 md:mb-16"
    >
        How I got here &mdash; and where it's going
    </p>

    <StorySection client:only />
</div>
